# Remote multi-organization node example for docker-compose.node.yml

# ----------------------------------------------------------
# GitHub authentication
# ----------------------------------------------------------
# token = existing PAT behavior
# app   = recommended for multiple orgs + personal repositories
GITHUB_AUTH_MODE=app

# PAT mode only:
ACCESS_TOKEN=

# GitHub App mode:
GITHUB_APP_ID=123456

# Recommended for .env files: base64-encode the downloaded PEM private key:
#   base64 -w0 your-github-app.private-key.pem
GITHUB_APP_PRIVATE_KEY_BASE64=PASTE_BASE64_PRIVATE_KEY_HERE

# Alternative: escaped PEM with \n sequences.
GITHUB_APP_PRIVATE_KEY=

# Installation access tokens expire after roughly one hour. The fleet refreshes
# its API token cache before expiry; running runners are not restarted hourly.
GITHUB_APP_TOKEN_REFRESH_SECONDS=3000

# auto = discover every active organization where the authenticated user has
# the GitHub organization admin role.
# You can instead provide: OrgOne,OrgTwo,OrgThree
GITHUB_ORGS=auto

# Optional filters used after automatic discovery.
GITHUB_ORG_INCLUDE=
GITHUB_ORG_EXCLUDE=

# Personal GitHub accounts do not have an account-wide runner scope, so fleet
# mode creates one repository-scoped runner per personal repository.
# auto = discover repositories owned by the authenticated personal account.
# Or set: NekoSuneVR/repo-one,NekoSuneVR/repo-two
GITHUB_PERSONAL_REPOS=auto
GITHUB_PERSONAL_REPO_INCLUDE=
GITHUB_PERSONAL_REPO_EXCLUDE=
GITHUB_PERSONAL_INCLUDE_ARCHIVED=false

# One runner registration is created per org and per selected personal repository, all on this one physical machine.
RUNNER_NAME_PREFIX=uk-vps-02
LABELS=docker,buildx,multiarch,builder
RUNNER_UPDATE_ON_START=true
ENABLE_MULTIARCH_ON_START=true
MULTIARCH_PLATFORMS=arm64,amd64

RUNNER_IMAGE=ghcr.io/nekosuneprojects/docker-github-runners:latest
NODE_AGENT_IMAGE=ghcr.io/nekosuneprojects/docker-github-runners-node-agent:latest

CENTRAL_DASHBOARD_URL=https://runner-dashboard.example.com
DASHBOARD_NODE_SHARED_SECRET=CHANGE_ME_TO_THE_SAME_64_HEX_SECRET

NODE_ID=uk-vps-02
NODE_NAME=UK Builder 02
NODE_LOCATION=London
NODE_HEARTBEAT_SECONDS=10
NODE_LOG_TAIL_BYTES=131072
NODE_RUNNER_STATUS_CACHE_SECONDS=90

# Re-read org membership and repair missing runner containers every 2 minutes.
NODE_FLEET_RECONCILE_SECONDS=120

# ----------------------------------------------------------
# Automatic VPS / node capacity classification
# ----------------------------------------------------------
# auto reads host CPU/RAM. Override with small, medium or large if needed.
NODE_CAPACITY_CLASS=auto

# auto checks whether the host Docker runtime exposes NVIDIA support.
# Override with true/false if detection is not correct.
NODE_GPU=auto

# Default automatic thresholds:
# small  = CPU <= 2 OR RAM <= 4 GB
# large  = CPU >= 8 AND RAM >= 16 GB
# medium = everything between those limits
NODE_SMALL_MAX_CPU=2
NODE_SMALL_MAX_RAM_GB=4
NODE_LARGE_MIN_CPU=8
NODE_LARGE_MIN_RAM_GB=16

# Auto-generated runner workload labels:
# small  -> neko-lite
# medium -> neko-build
# large  -> neko-build, neko-heavy
# GPU    -> neko-gpu
# every node also gets neko-any and neko-size-small/medium/large

# All org runners share ONE execution slot on this physical node.
# If another org is already running a job, the new job waits in its job-start
# hook until the active job completes. 3 days is only an emergency stale-lock
# fallback for a runner/container that dies before its completion hook executes.
NODE_SHARED_LOCK_STALE_SECONDS=259200

# Silent busy-job detection.
NODE_STUCK_WATCHDOG_ENABLED=true
NODE_STUCK_THRESHOLD_SECONDS=600
NODE_AUTO_RECOVER_STUCK=false
NODE_STUCK_RECOVERY_COOLDOWN_SECONDS=900
