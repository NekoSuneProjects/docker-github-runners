# GitHub Actions runner image configuration
#
# Normal fleet operation uses broker mode. The runner container receives only
# a short-lived registration token from the node-agent/dashboard control plane.
# Do NOT store a GitHub PAT or GitHub App private key in broker-managed runners.

# ----------------------------------------------------------
# Broker-managed mode (recommended)
# ----------------------------------------------------------
RUNNER_AUTH_MODE=broker

# Injected dynamically by the node-agent when the container is created:
RUNNER_REGISTRATION_TOKEN=
RUNNER_CONFIG_URL=

RUNNER_SCOPE=organization
RUNNER_NAME=neko-builder
LABELS=docker,buildx,multiarch,builder

RUNNER_UPDATE_ON_START=true
ENABLE_MULTIARCH_ON_START=true
MULTIARCH_PLATFORMS=arm64,amd64

# Physical-node single-job lock. Normally injected by the agent.
NODE_SHARED_JOB_LOCK=true
NODE_SHARED_LOCK_DIR=/runner-lock
NODE_SHARED_LOCK_STALE_SECONDS=259200

# ----------------------------------------------------------
# Standalone legacy/API mode
# ----------------------------------------------------------
# For running this image directly without the dashboard broker:
#
# RUNNER_AUTH_MODE=api
# ACCESS_TOKEN=github_pat_XXXXXXXXXXXXXXXXXXXXXXXX
#
# Organization runner:
# RUNNER_SCOPE=organization
# GITHUB_ORG=YourOrg
#
# Repository runner:
# RUNNER_SCOPE=repository
# REPO_URL=https://github.com/owner/repository
ACCESS_TOKEN=
GITHUB_ORG=
REPO_URL=
