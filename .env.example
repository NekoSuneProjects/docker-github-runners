# GitHub organization mode (recommended for multiple repos)
RUNNER_SCOPE=organization
GITHUB_ORG=YOUR_GITHUB_ORG

# GitHub token
# Fine-grained PAT recommended permissions:
# - Organization permission: Self-hosted runners = Read and write
# - Repository permission: Actions = Read (needed for dashboard runs/jobs/logs)
# - Select all repositories you want the dashboard to monitor
ACCESS_TOKEN=github_pat_XXXXXXXXXXXXXXXXXXXXXXXX

# Optional separate read-only PAT for the dashboard.
# If blank, the dashboard uses ACCESS_TOKEN.
GITHUB_DASHBOARD_TOKEN=

# Runner identity
# This image is intentionally lean: GitHub runner + Docker CLI/Buildx/Compose.
# Heavy compilers and language SDKs are NOT installed in the runner image.
RUNNER_NAME=neko-docker-builder
LABELS=docker,buildx,multiarch,builder

# Docker image names. GitHub Actions publishes all three as AMD64 + ARM64.
RUNNER_IMAGE=neko-github-builder:latest
DASHBOARD_IMAGE=neko-github-runner-dashboard:latest
NODE_AGENT_IMAGE=neko-github-runner-node-agent:latest

# Published GHCR equivalents:
# RUNNER_IMAGE=ghcr.io/nekosuneprojects/docker-github-runners:latest
# DASHBOARD_IMAGE=ghcr.io/nekosuneprojects/docker-github-runners-dashboard:latest
# NODE_AGENT_IMAGE=ghcr.io/nekosuneprojects/docker-github-runners-node-agent:latest

RUNNER_UPDATE_ON_START=true

# ----------------------------------------------------------
# Dashboard network
# ----------------------------------------------------------
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_REPOS=
DASHBOARD_MAX_REPOS=12
DASHBOARD_REFRESH_SECONDS=10

# ----------------------------------------------------------
# Private dashboard login
# ----------------------------------------------------------
# Authentication is fail-closed by default.
DASHBOARD_AUTH_REQUIRED=true
DASHBOARD_USERNAME=admin

# Use either plaintext OR SHA-256, not both.
# Recommended hash command:
#   printf '%s' 'YOUR_PASSWORD' | sha256sum | cut -d' ' -f1
DASHBOARD_PASSWORD=
DASHBOARD_PASSWORD_SHA256=

# Generate with: openssl rand -hex 32
DASHBOARD_SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_64_HEX_CHARACTER_VALUE
DASHBOARD_SESSION_TTL_HOURS=12

# Set true when the browser reaches the dashboard through HTTPS.
DASHBOARD_COOKIE_SECURE=false

# ----------------------------------------------------------
# Central multi-node dashboard
# ----------------------------------------------------------
# Generate a DIFFERENT secret with: openssl rand -hex 32
# Copy this exact value to every remote node that should connect.
DASHBOARD_NODE_SHARED_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_64_HEX_CHARACTER_VALUE

# A node becomes offline when its heartbeat is older than this value.
DASHBOARD_NODE_OFFLINE_SECONDS=45
DASHBOARD_NODE_MAX_LOG_BYTES=262144

# Identity for this machine in Connected build nodes.
# NODE_ID must be unique across every machine.
NODE_ID=central-builder
NODE_NAME=Central GitHub Builder
NODE_LOCATION=Primary VPS
NODE_HEARTBEAT_SECONDS=15
NODE_LOG_TAIL_BYTES=131072

# ----------------------------------------------------------
# Remote node-only settings
# ----------------------------------------------------------
# Used by docker-compose.node.yml on another machine.
# This must be the reachable address of your CENTRAL dashboard.
CENTRAL_DASHBOARD_URL=https://runner-dashboard.example.com

# Example values for another node:
# NODE_ID=uk-vps-02
# NODE_NAME=UK Builder 02
# NODE_LOCATION=London

# Repository mode example instead of organization mode:
# RUNNER_SCOPE=repository
# REPO_URL=https://github.com/YOUR_USER/YOUR_REPO
