# GitHub organization mode (recommended for multiple repos)
RUNNER_SCOPE=organization
GITHUB_ORG=YOUR_GITHUB_ORG

# GitHub token
# Fine-grained PAT recommended permissions:
# - Organization permission: Self-hosted runners = Read and write
# - Repository permission: Actions = Read (needed for dashboard runs/jobs/logs)
# - Select all repositories you want the dashboard to monitor
# Classic PAT alternative:
# - admin:org
# - repo (if private repositories are involved)
ACCESS_TOKEN=github_pat_XXXXXXXXXXXXXXXXXXXXXXXX

# Optional: use a separate read-only PAT for the dashboard.
# If blank, the dashboard uses ACCESS_TOKEN.
GITHUB_DASHBOARD_TOKEN=

# Runner identity
RUNNER_NAME=neko-multibuilder
LABELS=docker,buildx,crossbuild,builder

# Image name
RUNNER_IMAGE=neko-github-builder:latest

# Check actions/runner releases whenever the container starts
RUNNER_UPDATE_ON_START=true

# Docker socket permissions are detected automatically from
# /var/run/docker.sock when the container starts.

# ----------------------------------------------------------
# Dashboard
# ----------------------------------------------------------
# localhost is safest when placing Nginx Proxy Manager / Caddy in front.
# Change to 0.0.0.0 only if you intentionally want direct network access.
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8080

# Optional comma-separated repository names.
# Leave blank to automatically monitor the most recently pushed repositories
# in GITHUB_ORG, up to DASHBOARD_MAX_REPOS.
DASHBOARD_REPOS=
DASHBOARD_MAX_REPOS=12
DASHBOARD_REFRESH_SECONDS=10

# Optional HTTP Basic Auth. Strongly recommended if the dashboard is exposed
# outside localhost because workflow logs can contain sensitive information.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Repository mode example instead of organization mode:
# RUNNER_SCOPE=repository
# REPO_URL=https://github.com/YOUR_USER/YOUR_REPO
