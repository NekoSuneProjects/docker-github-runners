# ----------------------------------------------------------
# GitHub runner
# ----------------------------------------------------------
RUNNER_SCOPE=organization
GITHUB_ORG=YOUR_GITHUB_ORG
ACCESS_TOKEN=github_pat_XXXXXXXXXXXXXXXXXXXXXXXX
RUNNER_NAME=neko-docker-builder
LABELS=docker,buildx,multiarch,builder
RUNNER_UPDATE_ON_START=true
ENABLE_MULTIARCH_ON_START=true
MULTIARCH_PLATFORMS=arm64,amd64

# Images. These are published independently from the runner/dashboard/agent
# branches so changing one component does not rebuild the other two.
RUNNER_IMAGE=ghcr.io/nekosuneprojects/docker-github-runners:latest
DASHBOARD_IMAGE=ghcr.io/nekosuneprojects/docker-github-runners-dashboard:latest
NODE_AGENT_IMAGE=ghcr.io/nekosuneprojects/docker-github-runners-node-agent:latest

# ----------------------------------------------------------
# Dashboard + GitHub API
# ----------------------------------------------------------
# Optional separate dashboard PAT. If set, it takes priority over ACCESS_TOKEN.
# Viewing runs/logs needs Actions: read. Dashboard Stop build / Force stop /
# Rebuild controls need Actions: write on every repository being controlled.
GITHUB_DASHBOARD_TOKEN=
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_REPOS=
DASHBOARD_MAX_REPOS=12

# Browser updates use an authenticated WebSocket and do not poll GitHub.
# These values control backend/cache refresh only.
DASHBOARD_REFRESH_SECONDS=120
DASHBOARD_LIVE_GITHUB_SECONDS=300
DASHBOARD_SSE_KEEPALIVE_SECONDS=30
DASHBOARD_WS_PING_SECONDS=30

# Shared rate-aware GitHub REST cache.
DASHBOARD_GITHUB_CACHE_SECONDS=60
DASHBOARD_GITHUB_RUNS_CACHE_SECONDS=120
DASHBOARD_GITHUB_JOBS_CACHE_SECONDS=60
DASHBOARD_GITHUB_RUNNERS_CACHE_SECONDS=120
DASHBOARD_GITHUB_REPOS_CACHE_SECONDS=600
DASHBOARD_GITHUB_STALE_SECONDS=1800
DASHBOARD_GITHUB_RATE_RESERVE=750

# Persistent SQLite stale-while-revalidate GitHub cache. After a dashboard
# restart, cached GitHub responses are served immediately before the dashboard
# attempts a background network refresh.
DASHBOARD_GITHUB_PERSIST_FRESH_SECONDS=120
DASHBOARD_GITHUB_PERSIST_STALE_SECONDS=86400
DASHBOARD_GITHUB_PERSIST_MAX_ROWS=1000

# Persistent organization-runner inventory. All GitHub runner pages are stored
# in dashboard.sqlite. Missing/old registrations stay visible as offline rows.
DASHBOARD_GITHUB_RUNNER_SYNC_SECONDS=300
DASHBOARD_GITHUB_RUNNER_MAX_PAGES=100

# Slow fallback workflow sync. Active job/step changes are stored in SQLite and
# then pushed to browsers through WebSocket.
DASHBOARD_GITHUB_WORKFLOW_SYNC_SECONDS=180
DASHBOARD_GITHUB_WORKFLOW_RUNS_PER_REPO=8

# Optional TRUE GitHub realtime. Create an organization/repository webhook with:
# Payload URL: https://YOUR-DASHBOARD/api/github/webhook
# Content type: application/json
# Secret: the exact value below
# Events: workflow_job and workflow_run
# When configured, GitHub changes trigger an immediate SQLite sync + WebSocket push.
DASHBOARD_GITHUB_WEBHOOK_SECRET=

DASHBOARD_AUTH_REQUIRED=true
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# printf '%s' 'YOUR_PASSWORD' | sha256sum | cut -d' ' -f1
DASHBOARD_PASSWORD_SHA256=
# openssl rand -hex 32
DASHBOARD_SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_64_HEX_CHARACTER_VALUE
DASHBOARD_SESSION_TTL_HOURS=12
DASHBOARD_COOKIE_SECURE=false

# ----------------------------------------------------------
# Central multi-node controller
# ----------------------------------------------------------
DASHBOARD_NODE_SHARED_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_64_HEX_CHARACTER_VALUE
DASHBOARD_NODE_OFFLINE_SECONDS=45
DASHBOARD_NODE_MAX_LOG_BYTES=262144
DASHBOARD_NODE_MAX_BODY_BYTES=1048576
DASHBOARD_LOG_RETENTION_DAYS=30
DASHBOARD_LOG_MAX_ROWS_PER_NODE=500

NODE_ID=central-builder
NODE_NAME=Central GitHub Builder
NODE_LOCATION=Primary VPS
# Node heartbeat is local dashboard traffic and does NOT consume GitHub REST
# quota. Heartbeat changes are pushed to browsers immediately over WebSocket.
NODE_HEARTBEAT_SECONDS=10
NODE_LOG_TAIL_BYTES=131072

# ----------------------------------------------------------
# Runner recovery
# ----------------------------------------------------------
NODE_STUCK_WATCHDOG_ENABLED=true
NODE_STUCK_THRESHOLD_SECONDS=600
NODE_AUTO_RECOVER_STUCK=false
NODE_STUCK_RECOVERY_COOLDOWN_SECONDS=900

NODE_AUTO_RECOVER_OFFLINE=true
NODE_RUNNER_HEALTHCHECK_SECONDS=30
NODE_RUNNER_OFFLINE_RECOVERY_SECONDS=120
NODE_RUNNER_OFFLINE_RECOVERY_COOLDOWN_SECONDS=600

# ----------------------------------------------------------
# Remote node-only
# ----------------------------------------------------------
CENTRAL_DASHBOARD_URL=https://runner-dashboard.example.com

# Repository-scope example instead of organization scope:
# RUNNER_SCOPE=repository
# REPO_URL=https://github.com/YOUR_USER/YOUR_REPO
