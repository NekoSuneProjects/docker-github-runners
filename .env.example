# Node Agent / GitHub runner fleet configuration
# The AGENT owns GitHub runner lifecycle. The dashboard is monitoring/control only.

# Dashboard status/heartbeat connection
CENTRAL_DASHBOARD_URL=https://runners.nekosunevr.co.uk
DASHBOARD_NODE_SHARED_SECRET=CHANGE_ME_TO_THE_SAME_64_HEX_SECRET

# GitHub authentication used directly by this agent
GITHUB_AUTH_MODE=app
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_PRIVATE_KEY=

# PAT fallback:
# GITHUB_AUTH_MODE=token
# ACCESS_TOKEN=github_pat_...
ACCESS_TOKEN=

# Targets managed by this agent
GITHUB_ORGS=auto
GITHUB_ORG_INCLUDE=
GITHUB_ORG_EXCLUDE=

GITHUB_PERSONAL_REPOS=auto
GITHUB_PERSONAL_REPO_INCLUDE=
GITHUB_PERSONAL_REPO_EXCLUDE=
GITHUB_PERSONAL_INCLUDE_ARCHIVED=false

# Worker identity
NODE_ID=uk-vps-02
NODE_NAME=UK Builder 02
NODE_LOCATION=London
RUNNER_NAME_PREFIX=uk-vps-02

RUNNER_IMAGE=ghcr.io/nekosuneprojects/docker-github-runners:latest
NODE_AGENT_IMAGE=ghcr.io/nekosuneprojects/docker-github-runners-node-agent:latest

LABELS=docker,buildx,multiarch,builder
RUNNER_UPDATE_ON_START=true
ENABLE_MULTIARCH_ON_START=true
MULTIARCH_PLATFORMS=arm64,amd64

NODE_FLEET_RECONCILE_SECONDS=120
NODE_SHARED_LOCK_STALE_SECONDS=259200

NODE_CAPACITY_CLASS=auto
NODE_GPU=auto
NODE_SMALL_MAX_CPU=2
NODE_SMALL_MAX_RAM_GB=4
NODE_LARGE_MIN_CPU=8
NODE_LARGE_MIN_RAM_GB=16

NODE_HEARTBEAT_SECONDS=10
NODE_LOG_TAIL_BYTES=131072
NODE_RUNNER_STATUS_CACHE_SECONDS=90

NODE_STUCK_WATCHDOG_ENABLED=true
NODE_STUCK_THRESHOLD_SECONDS=600
NODE_AUTO_RECOVER_STUCK=false
NODE_STUCK_RECOVERY_COOLDOWN_SECONDS=900
